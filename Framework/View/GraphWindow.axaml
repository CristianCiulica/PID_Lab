<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Framework.ViewModel" xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia"
        x:Class="Framework.View.GraphWindow" Title="Graph" Width="540" Height="540"
        CanResize="False" WindowStartupLocation="CenterScreen" Closing="WindowClosing" Icon="avares://Framework/Images/Icon.png">
  <Border Classes="glass" Margin="24" Padding="16" ClipToBounds="True">
    <oxy:PlotView Model="{Binding Plot}" Background="Transparent"/>
  </Border>
</Window>