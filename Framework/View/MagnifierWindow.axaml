<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Framework.ViewModel" xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia"
        x:Class="Framework.View.MagnifierWindow" Title="Magnifier" Width="1040" Height="590"
        CanResize="False" WindowStartupLocation="CenterScreen" Closing="WindowClosing" Icon="avares://Framework/Images/Icon.png">
  <Window.DataContext><local:MagnifierVM/></Window.DataContext>
  <Grid Margin="24" RowDefinitions="42,*" ColumnDefinitions="*,20,*">
    <TextBlock Text="Initial Image" Classes="section" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="Processed Image" Classes="section" VerticalAlignment="Center"/>
    <Border Grid.Row="1" Classes="glass" Padding="18">
      <Image x:Name="imageBoxInitial" Source="{Binding InitialMagnifierImage}" Width="450" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Border Grid.Row="1" Grid.Column="2" Classes="glass" Padding="18">
      <Image x:Name="imageBoxProcessed" Source="{Binding ProcessedMagnifierImage}" Width="450" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</Window>